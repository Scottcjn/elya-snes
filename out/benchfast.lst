ca65 V2.18 - Ubuntu 2.19-2
Main file   : rom/bench.s
Current file: rom/bench.s

000000r 1               ; ---------------------------------------------------------------------------
000000r 1               ; bench.s -- the cycle instrument, and the arithmetic primitives it measures.
000000r 1               ;
000000r 1               ; INSTRUMENT
000000r 1               ;   ares has no scripting, so the counter is on the console.  Reading $2137
000000r 1               ;   latches the PPU's H and V counters; $213C/$213D then read them back.  V
000000r 1               ;   counts scanlines, H counts dots, and one dot is four master clocks.  So a
000000r 1               ;   measurement is: sync to the top of a frame, latch, run the workload, latch
000000r 1               ;   again, and hand the four raw numbers to the host through battery SRAM.  No
000000r 1               ;   arithmetic is done on the console -- the host does it, so the model can be
000000r 1               ;   changed without rebuilding a ROM.
000000r 1               ;
000000r 1               ;   Resolution is 4 master clocks, which is half of one SlowROM CPU cycle.
000000r 1               ;   Each workload runs thousands of times, so the per-operation resolution is
000000r 1               ;   far below a cycle.
000000r 1               ;
000000r 1               ; ACCOUNTING
000000r 1               ;   Every primitive runs inside the same loop skeleton, and `empty` is that
000000r 1               ;   skeleton with the bodies deleted.  Subtracting empty from a primitive
000000r 1               ;   cancels the loop bookkeeping exactly, leaving the cost of the bodies alone.
000000r 1               ;   Empty is measured at four different outer counts, which also proves the
000000r 1               ;   instrument is linear.
000000r 1               ; ---------------------------------------------------------------------------
000000r 1                       .include "snes.inc"
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; snes.inc -- register names and the cartridge header, shared by every ROM here.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; ---- PPU ------------------------------------------------------------------
000000r 2               INIDISP  = $2100        ; screen on/off + brightness ($8F = forced blank)
000000r 2               BGMODE   = $2105
000000r 2               M7SEL    = $211A
000000r 2               M7A      = $211B        ; Mode 7 matrix A  -- write TWICE (low byte, high byte)
000000r 2               M7B      = $211C        ; Mode 7 matrix B  -- ALSO the 2nd multiply operand
000000r 2               M7C      = $211D
000000r 2               M7D      = $211E
000000r 2               SLHV     = $2137        ; read: latch H/V counters
000000r 2               MPYL     = $2134        ; product bits  0.. 7   (M7A * M7B, signed 16x8 -> 24)
000000r 2               MPYM     = $2135        ; product bits  8..15
000000r 2               MPYH     = $2136        ; product bits 16..23
000000r 2               OPHCT    = $213C        ; horizontal counter latch, low/high (dots, 0..339)
000000r 2               OPVCT    = $213D        ; vertical counter latch, low/high (scanlines)
000000r 2               STAT78   = $213F        ; read: resets the H/V latch read toggle
000000r 2               
000000r 2               ; ---- CPU ------------------------------------------------------------------
000000r 2               NMITIMEN = $4200
000000r 2               WRIO     = $4201
000000r 2               WRMPYA   = $4202        ; hardware multiply operand A (unsigned 8)
000000r 2               WRMPYB   = $4203        ; operand B; writing this STARTS the 8-cycle multiply
000000r 2               WRDIVL   = $4204
000000r 2               WRDIVH   = $4205
000000r 2               WRDIVB   = $4206
000000r 2               MEMSEL   = $420D        ; bit0 = FastROM enable
000000r 2               RDDIVL   = $4214
000000r 2               RDDIVH   = $4215
000000r 2               RDMPYL   = $4216        ; product low   (8x8 -> 16 unsigned)
000000r 2               RDMPYH   = $4217        ; product high
000000r 2               
000000r 2               ; ---- where results go -----------------------------------------------------
000000r 2               ; LoROM battery SRAM. ares flushes this to a .srm next to the ROM on exit,
000000r 2               ; which is how the host reads numbers back out of the console.
000000r 2               SRAM     = $700000
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               .macro SNES_HEADER title, mapmode, carttype, romsize, ramsize
000000r 2                   .segment "SNESHDR"
000000r 2                   .assert .strlen(title) = 21, error, "cartridge title must be exactly 21 characters"
000000r 2                   .byte title             ; $FFC0  21 bytes, space padded
000000r 2                   .byte mapmode           ; $FFD5  $20 = LoROM/SlowROM, $30 = LoROM/FastROM
000000r 2                   .byte carttype          ; $FFD6  $02 = ROM + RAM + battery
000000r 2                   .byte romsize           ; $FFD7  log2(KiB): $05 = 32 KiB
000000r 2                   .byte ramsize           ; $FFD8  log2(KiB): $03 = 8 KiB
000000r 2                   .byte $01               ; $FFD9  country: NTSC / US
000000r 2                   .byte $00               ; $FFDA  developer id
000000r 2                   .byte $00               ; $FFDB  version
000000r 2                   .word $FFFF             ; $FFDC  checksum complement (patched by tools/fixhdr.py)
000000r 2                   .word $0000             ; $FFDE  checksum
000000r 2               .endmacro
000000r 2               
000000r 2               .macro SNES_VECTORS reset, nmi, irq
000000r 2                   .segment "VECTORS"
000000r 2                   .word $0000, $0000      ; $FFE0 unused
000000r 2                   .word $0000             ; $FFE4 native COP
000000r 2                   .word $0000             ; $FFE6 native BRK
000000r 2                   .word $0000             ; $FFE8 native ABORT
000000r 2                   .word nmi               ; $FFEA native NMI
000000r 2                   .word $0000             ; $FFEC unused
000000r 2                   .word irq               ; $FFEE native IRQ
000000r 2                   .word $0000, $0000      ; $FFF0 unused
000000r 2                   .word $0000             ; $FFF4 emu COP
000000r 2                   .word $0000             ; $FFF6 unused
000000r 2                   .word $0000             ; $FFF8 emu ABORT
000000r 2                   .word nmi               ; $FFFA emu NMI
000000r 2                   .word reset             ; $FFFC emu RESET
000000r 2                   .word irq               ; $FFFE emu IRQ/BRK
000000r 2               .endmacro
000000r 2               
000000r 1                       .p816
000000r 1                       .smart -
000000r 1               
000000r 1               ; ---- direct page ----------------------------------------------------------
000000r 1               ASAVE   = $00
000000r 1               OUTCNT  = $02
000000r 1               TMP     = $04
000000r 1               ACC     = $06
000000r 1               MCAND16 = $08
000000r 1               MULB16  = $0A
000000r 1               T0      = $0C
000000r 1               NOUT    = $0E
000000r 1               LATBUF  = $10           ; V1lo V1hi H1lo H1hi V2lo V2hi H2lo H2hi
000000r 1               
000000r 1               NELEM   = 128           ; elements per inner pass
000000r 1               UNROLL  = 16
000000r 1               
000000r 1               ; ===========================================================================
000000r 1               ; primitive bodies.  J is the unroll slot, 0..15.
000000r 1               ; ===========================================================================
000000r 1               
000000r 1               ; --- calibration: things whose cycle counts come off the datasheet ---------
000000r 1               .macro B_NOP j
000000r 1                       nop
000000r 1               .endmacro
000000r 1               
000000r 1               .macro B_LDA_ABSY j                     ; LDA abs,y, 16-bit A, no page cross
000000r 1                       lda W16Z + (j*2), y
000000r 1               .endmacro
000000r 1               
000000r 1               .macro B_LDA_DP j                       ; LDA dp, 16-bit A, DP low byte = 0
000000r 1                       lda T0
000000r 1               .endmacro
000000r 1               
000000r 1               .macro B_CLC_ADC_DP j
000000r 1                       clc
000000r 1                       adc T0
000000r 1               .endmacro
000000r 1               
000000r 1               .macro B_LDA_PPU j                      ; read of a "fast" (6 master) register
000000r 1                       lda MPYL
000000r 1               .endmacro
000000r 1               
000000r 1               ; --- 1. software 8x8 shift-add, 65816 native ------------------------------
000000r 1               ; multiplicand shifts left, multiplier shifts right, product accumulates in A.
000000r 1               .macro B_SOFTMUL j
000000r 1                       sep #$20
000000r 1                       .a8
000000r 1                       lda WB + j, y
000000r 1                       sta MCAND16
000000r 1                       stz MCAND16+1
000000r 1                       lda XB + j, y
000000r 1                       sta MULB16
000000r 1                       stz MULB16+1
000000r 1                       rep #$20
000000r 1                       .a16
000000r 1                       lda #0
000000r 1                       .repeat 8, K
000000r 1                       lsr MULB16
000000r 1                       bcc :+
000000r 1                       clc
000000r 1                       adc MCAND16
000000r 1               :
000000r 1                       .if K < 7
000000r 1                       asl MCAND16
000000r 1                       .endif
000000r 1                       .endrepeat
000000r 1                       clc
000000r 1                       adc ACC
000000r 1                       sta ACC
000000r 1               .endmacro
000000r 1               
000000r 1               ; --- 2. quarter-square table lookup ---------------------------------------
000000r 1               ; a*b = QS1[a+b] - QS2[(a-b)+255].  Exact for 0 <= a,b <= 255.
000000r 1               .macro B_QSQUARE j
000000r 1                       lda W16Z + (j*2), y
000000r 1                       clc
000000r 1                       adc X16Z + (j*2), y
000000r 1                       asl a
000000r 1                       tax
000000r 1                       lda QS1, x
000000r 1                       sta T0
000000r 1                       lda W16Z + (j*2), y
000000r 1                       sec
000000r 1                       sbc X16Z + (j*2), y
000000r 1                       clc
000000r 1                       adc #255
000000r 1                       asl a
000000r 1                       tax
000000r 1                       lda T0
000000r 1                       sec
000000r 1                       sbc QS2, x
000000r 1                       clc
000000r 1                       adc ACC
000000r 1                       sta ACC
000000r 1               .endmacro
000000r 1               
000000r 1               ; --- 3. CPU hardware multiply $4202/$4203 ---------------------------------
000000r 1               ; Safe form: separate 8-bit writes so $4203 is written exactly once, then
000000r 1               ; enough work before reading $4216 to cover the 8-cycle latency.
000000r 1               .macro B_CPUHW j
000000r 1                       sep #$20
000000r 1                       .a8
000000r 1                       lda WB + j, y
000000r 1                       sta WRMPYA
000000r 1                       lda XB + j, y
000000r 1                       sta WRMPYB              ; multiply starts here
000000r 1                       rep #$20
000000r 1                       .a16
000000r 1                       nop
000000r 1                       clc
000000r 1                       lda RDMPYL              ; read lands >= 8 CPU cycles after the write
000000r 1                       adc ACC
000000r 1                       sta ACC
000000r 1               .endmacro
000000r 1               
000000r 1               ; --- 3b. CPU hardware multiply, operands pre-packed -----------------------
000000r 1               ; One 16-bit store loads $4202 and $4203 together.  Lower bound only: packing
000000r 1               ; two runtime arrays into one is not free in a real engine.
000000r 1               .macro B_CPUHW_PK j
000000r 1                       ldx PK + (j*2), y
000000r 1                       stx WRMPYA              ; $4202 = w, $4203 = x, multiply starts
000000r 1                       nop
000000r 1                       nop                     ; one NOP is NOT enough: reading $4216 at
000000r 1                       clc                     ; exactly 8 CPU cycles returned a wrong sum
000000r 1                       adc RDMPYL              ; (caught by the correctness pass), so 10.
000000r 1               .endmacro
000000r 1               
000000r 1               ; --- 4. PPU Mode 7 multiply $211B/$211C -----------------------------------
000000r 1               ; M7A takes two writes to $211B (low byte then high byte); M7B takes one write
000000r 1               ; to $211C.  A 16-bit store spans two registers, so two stores cover all three
000000r 1               ; writes:  stx $211A -> ($211A junk, $211B = w)   [M7A low]
000000r 1               ;          stx $211B -> ($211B = 0,   $211C = x)  [M7A high, M7B]
000000r 1               ; Accumulator stays in A the whole time; X carries the operands.
000000r 1               .macro B_PPU j
000000r 1                       ldx WHI + (j*2), y
000000r 1                       stx M7SEL               ; $211A/$211B  -> M7A low byte = w
000000r 1                       ldx XHI + (j*2), y
000000r 1                       stx M7A                 ; $211B/$211C  -> M7A high = 0, M7B = x
000000r 1                       clc
000000r 1                       adc MPYL                ; 16 low bits of the 24-bit signed product
000000r 1               .endmacro
000000r 1               
000000r 1               ; --- 4b. PPU Mode 7 multiply, textbook form -------------------------------
000000r 1               ; The obvious way to write it: 8-bit stores, two explicit writes to $211B,
000000r 1               ; accumulator in memory.  Measured to price the two-write M7A cost honestly.
000000r 1               .macro B_PPU_NAIVE j
000000r 1                       sep #$20
000000r 1                       .a8
000000r 1                       lda WB + j, y
000000r 1                       sta M7A                 ; M7A low byte
000000r 1                       stz M7A                 ; M7A high byte
000000r 1                       lda XB + j, y
000000r 1                       sta M7B
000000r 1                       rep #$20
000000r 1                       .a16
000000r 1                       lda MPYL
000000r 1                       clc
000000r 1                       adc ACC
000000r 1                       sta ACC
000000r 1               .endmacro
000000r 1               
000000r 1               ; --- 5. ternary sign-separated gather -------------------------------------
000000r 1               ; No multiply at all.  Weights are -1/0/+1, the zeros never appear, and the
000000r 1               ; non-zeros are two index lists.  Slots 0-7 are the +1 list, 8-15 the -1 list.
000000r 1               .macro B_TERNARY j
000000r 1                       ldx IDX + (j*2), y
000000r 1                       .if j < 8
000000r 1                       clc
000000r 1                       adc XS16, x
000000r 1                       .else
000000r 1                       sec
000000r 1                       sbc XS16, x
000000r 1                       .endif
000000r 1               .endmacro
000000r 1               
000000r 1               
000000r 1               ; --- 6. DSP-1 (NEC uPD77C25) via its documented Multiply command -----------
000000r 1               ; DSP-1 op $00 is a 16x16 signed multiply returning (M*N)>>15, so int8 operands
000000r 1               ; are usable pre-scaled: (w<<8) * (x<<7) >> 15 == w*x exactly.  The chip runs at
000000r 1               ; ~8 MHz and in parallel with the CPU, but every operand and every result has to
000000r 1               ; cross the cartridge bus, and in LoROM the DSP data register lives at
000000r 1               ; $30:8000 -- a "slow" 8-master-clock address like any other cart address.
000000r 1               ;
000000r 1               ; The DSP-1 firmware is not available on this machine, so what is measured here
000000r 1               ; is the CPU-side transfer sequence alone: no command byte (the DSP-1 repeats
000000r 1               ; its last command when fed bare parameters), no RQM polling loop, and no DSP
000000r 1               ; execution time.  That makes it a hard LOWER BOUND on the real cost, not the
000000r 1               ; real cost.  Access timing on the 65816 is decided by the address, not by
000000r 1               ; whether a chip answers, so the cycle counts are exact even with no DSP fitted.
000000r 1               .macro B_DSP1_FLOOR j
000000r 1                       lda WHI + (j*2), y      ; multiplicand
000000r 1                       sta f:$308000           ; -> DR
000000r 1                       lda XHI + (j*2), y      ; multiplier
000000r 1                       sta f:$308000           ; -> DR
000000r 1                       lda f:$308000           ; <- product
000000r 1                       clc
000000r 1                       adc ACC
000000r 1                       sta ACC
000000r 1               .endmacro
000000r 1               
000000r 1               ; the same, plus the single status-register read that the cheapest possible
000000r 1               ; correct driver still has to do before trusting the result
000000r 1               .macro B_DSP1_SR j
000000r 1                       lda WHI + (j*2), y
000000r 1                       sta f:$308000
000000r 1                       lda XHI + (j*2), y
000000r 1                       sta f:$308000
000000r 1                       lda f:$30C000           ; SR -- one read, not a poll loop
000000r 1                       lda f:$308000
000000r 1                       clc
000000r 1                       adc ACC
000000r 1                       sta ACC
000000r 1               .endmacro
000000r 1               
000000r 1               ; ===========================================================================
000000r 1               ; ===========================================================================
000000r 1               ; loop skeleton
000000r 1               ; ===========================================================================
000000r 1               .macro LOOPTAIL stride, lbl
000000r 1                       sta ASAVE
000000r 1                       tya
000000r 1                       clc
000000r 1                       adc #(stride*::UNROLL)
000000r 1                       tay
000000r 1                       lda ASAVE
000000r 1                       cpy #(stride*::NELEM)
000000r 1                       beq :+
000000r 1                       brl lbl                 ; unrolled bodies overflow an 8-bit branch;
000000r 1               :                               ; every test uses the same long form so the
000000r 1               .endmacro                       ; skeleton still cancels against `empty`.
000000r 1               
000000r 1               ; ca65 will not accept a macro name as a macro argument, so the per-test
000000r 1               ; wrapper is a head/tail pair and each test spells out its own .repeat.
000000r 1               .macro THEAD
000000r 1                       lda NOUT
000000r 1                       sta OUTCNT
000000r 1                       stz ACC
000000r 1                       lda #0
000000r 1               .endmacro
000000r 1               
000000r 1               .macro TTAIL stride
000000r 1                       LOOPTAIL stride, inner
000000r 1                       dec OUTCNT
000000r 1                       beq :+
000000r 1                       brl outer
000000r 1               :
000000r 1                       sta ACC                 ; A-resident accumulators land here too
000000r 1                       rep #$30
000000r 1                       .a16
000000r 1                       .i16
000000r 1                       rts
000000r 1               .endmacro
000000r 1               
000000r 1                       .segment "CODE"
000000r 1               
000000r 1               ; FASTROM=1 builds the same measurements at 3.58 MHz: map mode $30, MEMSEL bit
000000r 1               ; 0 set, and execution moved to bank $80 where ROM accesses take 6 master
000000r 1               ; clocks instead of 8.  WRAM and direct page stay slow either way.
000000r 1               .ifdef FASTROM
000000r 1               MAPMODE = $30
000000r 1               .else
000000r 1               MAPMODE = $20
000000r 1               .endif
000000r 1               
000000r 1               ; ===========================================================================
000000r 1               reset:
000000r 1  78                   sei
000001r 1  18                   clc
000002r 1  FB                   xce
000003r 1                       .a16
000003r 1                       .i16
000003r 1  C2 38                rep #$38
000005r 1  A2 FF 1F             ldx #$1FFF
000008r 1  9A                   txs
000009r 1  A9 00 00             lda #$0000
00000Cr 1  5B                   tcd
00000Dr 1  E2 20                sep #$20
00000Fr 1                       .a8
00000Fr 1  4B                   phk
000010r 1  AB                   plb
000011r 1               
000011r 1  A9 8F                lda #$8F
000013r 1  8D 00 21             sta INIDISP             ; forced blank
000016r 1  9C 00 42             stz NMITIMEN
000019r 1  9C 0B 42             stz $420B
00001Cr 1  9C 0C 42             stz $420C
00001Fr 1               .ifdef FASTROM
00001Fr 1  A9 01                lda #$01
000021r 1  8D 0D 42             sta MEMSEL              ; FastROM: banks $80-$FF fetch in 6 master clocks
000024r 1  5C rr rr rr          jml $800000 + fast_entry ; ...but only if we execute from there
000028r 1               fast_entry:
000028r 1  4B                   phk
000029r 1  AB                   plb                     ; data bank = $80 too, so operand arrays are fast
00002Ar 1               .else
00002Ar 1                       stz MEMSEL              ; SlowROM: every ROM access is 8 master clocks
00002Ar 1               .endif
00002Ar 1  A9 01                lda #$01
00002Cr 1  8D 05 21             sta BGMODE              ; mode 1 -- NOT mode 7, so $211B/$211C are ours
00002Fr 1  9C 2C 21             stz $212C
000032r 1  9C 2D 21             stz $212D
000035r 1               
000035r 1  C2 30                rep #$30
000037r 1                       .a16
000037r 1                       .i16
000037r 1               
000037r 1                       ; magic
000037r 1  E2 20                sep #$20
000039r 1                       .a8
000039r 1  A9 42                lda #$42                ; 'B'
00003Br 1  8F 00 00 70          sta f:SRAM+0
00003Fr 1  A9 4E                lda #$4E                ; 'N'
000041r 1  8F 01 00 70          sta f:SRAM+1
000045r 1  A9 43                lda #$43                ; 'C'
000047r 1  8F 02 00 70          sta f:SRAM+2
00004Br 1  A9 48                lda #$48                ; 'H'
00004Dr 1  8F 03 00 70          sta f:SRAM+3
000051r 1  A9 00                lda #$00                ; DONE marker cleared (STZ has no long mode)
000053r 1  8F 08 00 70          sta f:SRAM+8
000057r 1  8F 09 00 70          sta f:SRAM+9
00005Br 1  8F 0A 00 70          sta f:SRAM+10
00005Fr 1  8F 0B 00 70          sta f:SRAM+11
000063r 1  C2 30                rep #$30
000065r 1                       .a16
000065r 1                       .i16
000065r 1               
000065r 1  20 rr rr             jsr run_pass            ; pass 1  -> SRAM+$0010
000068r 1  20 rr rr             jsr run_pass            ; pass 2  -> same slots, overwritten
00006Br 1  20 rr rr             jsr run_verify          ; correctness of every primitive
00006Er 1               
00006Er 1  E2 20                sep #$20
000070r 1                       .a8
000070r 1  A9 44                lda #$44                ; 'D'
000072r 1  8F 08 00 70          sta f:SRAM+8
000076r 1  A9 4F                lda #$4F                ; 'O'
000078r 1  8F 09 00 70          sta f:SRAM+9
00007Cr 1  A9 4E                lda #$4E                ; 'N'
00007Er 1  8F 0A 00 70          sta f:SRAM+10
000082r 1  A9 45                lda #$45                ; 'E'
000084r 1  8F 0B 00 70          sta f:SRAM+11
000088r 1  C2 30                rep #$30
00008Ar 1                       .a16
00008Ar 1                       .i16
00008Ar 1  80 FE        halt:   bra halt
00008Cr 1               
00008Cr 1               ; ===========================================================================
00008Cr 1               ; run every timing slot
00008Cr 1               ; ===========================================================================
00008Cr 1               .macro SLOT sub, outercnt, idx
00008Cr 1                       lda #outercnt
00008Cr 1                       sta NOUT
00008Cr 1                       jsr sync_frame
00008Cr 1                       jsr latch_start
00008Cr 1                       jsr sub
00008Cr 1                       jsr latch_end
00008Cr 1                       ldx #(idx*8)
00008Cr 1                       jsr store_result
00008Cr 1               .endmacro
00008Cr 1               
00008Cr 1               .proc run_pass
00008Cr 1                       ; --- linearity of the instrument: the same empty skeleton, 4 lengths
00008Cr 1  A9 02 00 85          SLOT t_empty,   2,  0
000090r 1  0E 20 rr rr  
000094r 1  20 rr rr 20  
0000A3r 1  A9 04 00 85          SLOT t_empty,   4,  1
0000A7r 1  0E 20 rr rr  
0000ABr 1  20 rr rr 20  
0000BAr 1  A9 08 00 85          SLOT t_empty,   8,  2
0000BEr 1  0E 20 rr rr  
0000C2r 1  20 rr rr 20  
0000D1r 1  A9 10 00 85          SLOT t_empty,  16,  3
0000D5r 1  0E 20 rr rr  
0000D9r 1  20 rr rr 20  
0000E8r 1                       ; --- calibration bodies, all hand-derivable
0000E8r 1  A9 10 00 85          SLOT t_nop,    16,  4
0000ECr 1  0E 20 rr rr  
0000F0r 1  20 rr rr 20  
0000FFr 1  A9 10 00 85          SLOT t_ldaabsy,16,  5
000103r 1  0E 20 rr rr  
000107r 1  20 rr rr 20  
000116r 1  A9 10 00 85          SLOT t_ldadp,  16,  6
00011Ar 1  0E 20 rr rr  
00011Er 1  20 rr rr 20  
00012Dr 1  A9 10 00 85          SLOT t_clcadc, 16,  7
000131r 1  0E 20 rr rr  
000135r 1  20 rr rr 20  
000144r 1  A9 10 00 85          SLOT t_ldappu, 16,  8
000148r 1  0E 20 rr rr  
00014Cr 1  20 rr rr 20  
00015Br 1                       ; --- the primitives.  Outer counts are sized so the longest window is
00015Br 1                       ;     ~140 scanlines, well short of the 262-line frame; each primitive
00015Br 1                       ;     is also measured at half length so the two must agree.
00015Br 1  A9 01 00 85          SLOT t_softmul, 1,  9
00015Fr 1  0E 20 rr rr  
000163r 1  20 rr rr 20  
000172r 1  A9 02 00 85          SLOT t_qsquare, 2, 10
000176r 1  0E 20 rr rr  
00017Ar 1  20 rr rr 20  
000189r 1  A9 01 00 85          SLOT t_qsquare, 1, 11
00018Dr 1  0E 20 rr rr  
000191r 1  20 rr rr 20  
0001A0r 1  A9 04 00 85          SLOT t_cpuhw,   4, 12
0001A4r 1  0E 20 rr rr  
0001A8r 1  20 rr rr 20  
0001B7r 1  A9 02 00 85          SLOT t_cpuhw,   2, 13
0001BBr 1  0E 20 rr rr  
0001BFr 1  20 rr rr 20  
0001CEr 1  A9 08 00 85          SLOT t_cpuhwpk, 8, 14
0001D2r 1  0E 20 rr rr  
0001D6r 1  20 rr rr 20  
0001E5r 1  A9 04 00 85          SLOT t_cpuhwpk, 4, 15
0001E9r 1  0E 20 rr rr  
0001EDr 1  20 rr rr 20  
0001FCr 1  A9 08 00 85          SLOT t_ppu,     8, 16
000200r 1  0E 20 rr rr  
000204r 1  20 rr rr 20  
000213r 1  A9 04 00 85          SLOT t_ppu,     4, 17
000217r 1  0E 20 rr rr  
00021Br 1  20 rr rr 20  
00022Ar 1  A9 04 00 85          SLOT t_ppunaive,4, 18
00022Er 1  0E 20 rr rr  
000232r 1  20 rr rr 20  
000241r 1  A9 02 00 85          SLOT t_ppunaive,2, 19
