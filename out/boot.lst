ca65 V2.18 - Ubuntu 2.19-2
Main file   : rom/boot.s
Current file: rom/boot.s

000000r 1               ; ---------------------------------------------------------------------------
000000r 1               ; boot.s -- step 1: does a ROM boot under ares, and can we read a value back?
000000r 1               ;
000000r 1               ; Two independent readouts, on purpose, so that if one channel is broken the
000000r 1               ; other still tells us whether the CPU ran:
000000r 1               ;   1. visual  -- backdrop goes green, then the brightness pulses once a frame
000000r 1               ;   2. data    -- a magic pattern + a live frame counter in battery SRAM,
000000r 1               ;                 which ares flushes to a .srm file on exit
000000r 1               ; ---------------------------------------------------------------------------
000000r 1                       .include "snes.inc"
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; snes.inc -- register names and the cartridge header, shared by every ROM here.
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; ---- PPU ------------------------------------------------------------------
000000r 2               INIDISP  = $2100        ; screen on/off + brightness ($8F = forced blank)
000000r 2               BGMODE   = $2105
000000r 2               M7SEL    = $211A
000000r 2               M7A      = $211B        ; Mode 7 matrix A  -- write TWICE (low byte, high byte)
000000r 2               M7B      = $211C        ; Mode 7 matrix B  -- ALSO the 2nd multiply operand
000000r 2               M7C      = $211D
000000r 2               M7D      = $211E
000000r 2               SLHV     = $2137        ; read: latch H/V counters
000000r 2               MPYL     = $2134        ; product bits  0.. 7   (M7A * M7B, signed 16x8 -> 24)
000000r 2               MPYM     = $2135        ; product bits  8..15
000000r 2               MPYH     = $2136        ; product bits 16..23
000000r 2               OPHCT    = $213C        ; horizontal counter latch, low/high (dots, 0..339)
000000r 2               OPVCT    = $213D        ; vertical counter latch, low/high (scanlines)
000000r 2               STAT78   = $213F        ; read: resets the H/V latch read toggle
000000r 2               
000000r 2               ; ---- CPU ------------------------------------------------------------------
000000r 2               NMITIMEN = $4200
000000r 2               WRIO     = $4201
000000r 2               WRMPYA   = $4202        ; hardware multiply operand A (unsigned 8)
000000r 2               WRMPYB   = $4203        ; operand B; writing this STARTS the 8-cycle multiply
000000r 2               WRDIVL   = $4204
000000r 2               WRDIVH   = $4205
000000r 2               WRDIVB   = $4206
000000r 2               MEMSEL   = $420D        ; bit0 = FastROM enable
000000r 2               RDDIVL   = $4214
000000r 2               RDDIVH   = $4215
000000r 2               RDMPYL   = $4216        ; product low   (8x8 -> 16 unsigned)
000000r 2               RDMPYH   = $4217        ; product high
000000r 2               
000000r 2               ; ---- where results go -----------------------------------------------------
000000r 2               ; LoROM battery SRAM. ares flushes this to a .srm next to the ROM on exit,
000000r 2               ; which is how the host reads numbers back out of the console.
000000r 2               SRAM     = $700000
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               .macro SNES_HEADER title, mapmode, carttype, romsize, ramsize
000000r 2                   .segment "SNESHDR"
000000r 2                   .assert .strlen(title) = 21, error, "cartridge title must be exactly 21 characters"
000000r 2                   .byte title             ; $FFC0  21 bytes, space padded
000000r 2                   .byte mapmode           ; $FFD5  $20 = LoROM/SlowROM, $30 = LoROM/FastROM
000000r 2                   .byte carttype          ; $FFD6  $02 = ROM + RAM + battery
000000r 2                   .byte romsize           ; $FFD7  log2(KiB): $05 = 32 KiB
000000r 2                   .byte ramsize           ; $FFD8  log2(KiB): $03 = 8 KiB
000000r 2                   .byte $01               ; $FFD9  country: NTSC / US
000000r 2                   .byte $00               ; $FFDA  developer id
000000r 2                   .byte $00               ; $FFDB  version
000000r 2                   .word $FFFF             ; $FFDC  checksum complement (patched by tools/fixhdr.py)
000000r 2                   .word $0000             ; $FFDE  checksum
000000r 2               .endmacro
000000r 2               
000000r 2               .macro SNES_VECTORS reset, nmi, irq
000000r 2                   .segment "VECTORS"
000000r 2                   .word $0000, $0000      ; $FFE0 unused
000000r 2                   .word $0000             ; $FFE4 native COP
000000r 2                   .word $0000             ; $FFE6 native BRK
000000r 2                   .word $0000             ; $FFE8 native ABORT
000000r 2                   .word nmi               ; $FFEA native NMI
000000r 2                   .word $0000             ; $FFEC unused
000000r 2                   .word irq               ; $FFEE native IRQ
000000r 2                   .word $0000, $0000      ; $FFF0 unused
000000r 2                   .word $0000             ; $FFF4 emu COP
000000r 2                   .word $0000             ; $FFF6 unused
000000r 2                   .word $0000             ; $FFF8 emu ABORT
000000r 2                   .word nmi               ; $FFFA emu NMI
000000r 2                   .word reset             ; $FFFC emu RESET
000000r 2                   .word irq               ; $FFFE emu IRQ/BRK
000000r 2               .endmacro
000000r 2               
000000r 1                       .p816
000000r 1                       .smart -
000000r 1               
000000r 1                       .segment "CODE"
000000r 1               
000000r 1               reset:
000000r 1  78                   sei
000001r 1  18                   clc
000002r 1  FB                   xce                     ; leave 6502 emulation mode -> 65816 native
000003r 1                       .a16
000003r 1                       .i16
000003r 1  C2 38                rep #$38                ; A/X/Y 16-bit, decimal off
000005r 1  A2 FF 1F             ldx #$1FFF
000008r 1  9A                   txs                     ; stack at $1FFF
000009r 1  A9 00 00             lda #$0000
00000Cr 1  5B                   tcd                     ; direct page = $0000
00000Dr 1  E2 20                sep #$20
00000Fr 1                       .a8
00000Fr 1  4B                   phk
000010r 1  AB                   plb                     ; data bank = program bank = $00
000011r 1               
000011r 1  A9 8F                lda #$8F
000013r 1  8D 00 21             sta INIDISP             ; forced blank while we set up
000016r 1  9C 00 42             stz NMITIMEN            ; no NMI, no auto-joypad
000019r 1  9C 0B 42             stz $420B               ; no DMA
00001Cr 1  9C 0C 42             stz $420C               ; no HDMA
00001Fr 1               
00001Fr 1                       ; backdrop colour 0 = green ($03E0 in BGR555)
00001Fr 1  9C 21 21             stz $2121
000022r 1  A9 E0                lda #$E0
000024r 1  8D 22 21             sta $2122
000027r 1  A9 03                lda #$03
000029r 1  8D 22 21             sta $2122
00002Cr 1               
00002Cr 1  A9 01                lda #$01
00002Er 1  8D 05 21             sta BGMODE              ; mode 1, nothing enabled -> pure backdrop
000031r 1  9C 2C 21             stz $212C               ; main screen: nothing
000034r 1  9C 2D 21             stz $212D
000037r 1               
000037r 1                       ; ---- magic pattern into battery SRAM -------------------------------
000037r 1  A9 53                lda #$53                ; 'S'
000039r 1  8F 00 00 70          sta f:SRAM+0
00003Dr 1  A9 4E                lda #$4E                ; 'N'
00003Fr 1  8F 01 00 70          sta f:SRAM+1
000043r 1  A9 45                lda #$45                ; 'E'
000045r 1  8F 02 00 70          sta f:SRAM+2
000049r 1  A9 53                lda #$53                ; 'S'
00004Br 1  8F 03 00 70          sta f:SRAM+3
00004Fr 1  A9 5A                lda #$5A                ; marker
000051r 1  8F 04 00 70          sta f:SRAM+4
000055r 1  A9 A5                lda #$A5
000057r 1  8F 05 00 70          sta f:SRAM+5
00005Br 1  A9 00                lda #$00
00005Dr 1  8F 06 00 70          sta f:SRAM+6            ; frame counter low
000061r 1  8F 07 00 70          sta f:SRAM+7            ; frame counter high
000065r 1               
000065r 1  A9 0F                lda #$0F
000067r 1  8D 00 21             sta INIDISP             ; screen on, full brightness
00006Ar 1               
00006Ar 1                       ; ---- alive loop: count frames into SRAM ----------------------------
00006Ar 1                       ; $4212 (HVBJOY) bit7 is a level, not a latch, so polling it is safe.
00006Ar 1  C2 20                rep #$20
00006Cr 1                       .a16
00006Cr 1  A9 00 00             lda #$0000
00006Fr 1  85 00                sta $00                 ; 16-bit frame counter in direct page
000071r 1  E2 20                sep #$20
000073r 1                       .a8
000073r 1               
000073r 1               alive:
000073r 1  AD 12 42     :       lda $4212
000076r 1  30 FB                bmi :-                  ; wait for vblank to end
000078r 1  AD 12 42     :       lda $4212
00007Br 1  10 FB                bpl :-                  ; wait for vblank to begin
00007Dr 1               
00007Dr 1  E6 00                inc $00
00007Fr 1  D0 02                bne :+
000081r 1  E6 01                inc $01
000083r 1  A5 00        :       lda $00
000085r 1  8F 06 00 70          sta f:SRAM+6
000089r 1  A5 01                lda $01
00008Br 1  8F 07 00 70          sta f:SRAM+7
00008Fr 1  80 E2                bra alive
000091r 1               
000091r 1               nmi:
000091r 1  40                   rti
000092r 1               irq:
000092r 1  40                   rti
000093r 1               
000093r 1  45 4C 59 41          SNES_HEADER "ELYA SNES BOOT       ", $20, $02, $05, $03
000097r 1  20 53 4E 45  
00009Br 1  53 20 42 4F  
000020r 1  00 00 00 00          SNES_VECTORS reset, nmi, irq
000024r 1  00 00 00 00  
000028r 1  00 00 rr rr  
000020r 1               
